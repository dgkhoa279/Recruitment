[Unit]
Description=Ollama for Recruitment Dev
After=network-online.target

[Service]
Type=simple
ExecStart=/home/dgkhoa/Recruitment_Detail/Recruitment_Dev/third_party/ollama/dist/bin/ollama serve
Restart=on-failure
RestartSec=3

Environment="OLLAMA_HOST=127.0.0.1:11434"
Environment="OLLAMA_MODELS=/media/dgkhoa/Data/ollama-models"
Environment="OLLAMA_MAX_LOADED_MODELS=1"
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_CONTEXT_LENGTH=4096"
Environment="OLLAMA_KEEP_ALIVE=30s"
Environment="OLLAMA_MAX_QUEUE=16"
Environment="OLLAMA_NO_CLOUD=1"

MemoryHigh=11G
MemoryMax=13G
MemorySwapMax=4G

[Install]
WantedBy=default.target
