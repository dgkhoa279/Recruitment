<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_muk_ai_provider_form_ollama" model="ir.ui.view">
        <field name="name">muk_ai.provider.form.ollama</field>
        <field name="model">muk_ai.provider</field>
        <field name="inherit_id" ref="muk_ai.view_muk_ai_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='api_key']" position="attributes">
                <attribute name="invisible">name == 'ollama'</attribute>
            </xpath>
            <xpath expr="//field[@name='api_key']" position="after">
                <field name="ollama_url" invisible="name != 'ollama'"/>
                <field
                    name="ollama_fallback_provider_id"
                    options="{'no_create': True}"
                    invisible="name != 'ollama'"
                />
            </xpath>
        </field>
    </record>
</odoo>
