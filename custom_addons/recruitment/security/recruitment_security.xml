<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module Category -->
        <record id="module_category_recruitment" model="ir.module.category">
            <field name="name">Tuyển Dụng (Recruitment)</field>
            <field name="description">Quản lý phân quyền Tuyển dụng Nhân sự</field>
            <field name="sequence">20</field>
        </record>

        <!-- Group 1: Interviewer (Người phỏng vấn / Trưởng phòng chuyên môn) -->
        <record id="group_recruitment_interviewer" model="res.groups">
            <field name="name">Người phỏng vấn (Interviewer)</field>
            <field name="category_id" ref="module_category_recruitment"/>
            <field name="comment">Chỉ xem hồ sơ phòng ban mình, thực hiện chấm điểm buổi phỏng vấn. Ẩn hoàn toàn thông tin Lương/Offer.</field>
        </record>

        <!-- Group 2: HR Officer (Chuyên viên Tuyển dụng) -->
        <record id="group_recruitment_user" model="res.groups">
            <field name="name">Chuyên viên Tuyển dụng (Officer)</field>
            <field name="category_id" ref="module_category_recruitment"/>
            <field name="implied_ids" eval="[(4, ref('group_recruitment_interviewer'))]"/>
            <field name="comment">Tiếp nhận CV, lên lịch phỏng vấn, tạo nháp Offer. Không được phép xóa vĩnh viễn dữ liệu vận hành.</field>
        </record>

        <!-- Group 3: HR Manager (Trưởng phòng Tuyển dụng) -->
        <record id="group_recruitment_manager" model="res.groups">
            <field name="name">Quản lý Tuyển dụng (Manager)</field>
            <field name="category_id" ref="module_category_recruitment"/>
            <field name="implied_ids" eval="[(4, ref('group_recruitment_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Quản lý toàn bộ hồ sơ tuyển dụng các phòng ban, duyệt ký Offer, cấu hình Danh mục quy trình.</field>
        </record>

        <!-- ================================================================= -->
        <!-- RECORD RULES (QUY TẮC TRUY CẬP DỮ LIỆU PHÒNG BAN)                -->
        <!-- ================================================================= -->

        <!-- Record Rule 1: Interviewer chỉ thấy Vị trí tuyển dụng thuộc Phòng ban mình -->
        <record id="recruitment_job_position_interviewer_rule" model="ir.rule">
            <field name="name">Interviewer: Xem Vị trí tuyển dụng thuộc Phòng ban</field>
            <field name="model_id" ref="model_recruitment_job_position"/>
            <field name="groups" eval="[(4, ref('group_recruitment_interviewer'))]"/>
            <field name="domain_force">['|', ('department_id', '=', False), ('department_id', '=', user.employee_id.department_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rule 2: Interviewer chỉ thấy Đơn ứng tuyển thuộc Phòng ban mình hoặc được gán phỏng vấn -->
        <record id="recruitment_application_interviewer_rule" model="ir.rule">
            <field name="name">Interviewer: Xem Đơn ứng tuyển thuộc Phòng ban hoặc được gán phỏng vấn</field>
            <field name="model_id" ref="model_recruitment_application"/>
            <field name="groups" eval="[(4, ref('group_recruitment_interviewer'))]"/>
            <field name="domain_force">['|', '|', ('department_id', '=', False), ('department_id', '=', user.employee_id.department_id.id), ('interviewer_user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rule 3: HR Officer & Manager xem toàn bộ Vị trí tuyển dụng -->
        <record id="recruitment_job_position_officer_rule" model="ir.rule">
            <field name="name">HR Officer/Manager: Xem toàn bộ Vị trí tuyển dụng</field>
            <field name="model_id" ref="model_recruitment_job_position"/>
            <field name="groups" eval="[(4, ref('group_recruitment_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Record Rule 4: HR Officer & Manager xem toàn bộ Đơn ứng tuyển -->
        <record id="recruitment_application_officer_rule" model="ir.rule">
            <field name="name">HR Officer/Manager: Xem toàn bộ Đơn ứng tuyển</field>
            <field name="model_id" ref="model_recruitment_application"/>
            <field name="groups" eval="[(4, ref('group_recruitment_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="recruitment_cv_chunk_interviewer_rule" model="ir.rule">
            <field name="name">Interviewer: RAG chunks theo phòng ban</field>
            <field name="model_id" ref="model_recruitment_cv_chunk"/>
            <field name="groups" eval="[(4, ref('group_recruitment_interviewer'))]"/>
            <field name="domain_force">['|', '|', ('job_position_id.department_id', '=', False), ('job_position_id.department_id', '=', user.employee_id.department_id.id), ('application_id.interviewer_user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="recruitment_cv_chunk_officer_rule" model="ir.rule">
            <field name="name">HR Officer/Manager: Toàn bộ RAG chunks</field>
            <field name="model_id" ref="model_recruitment_cv_chunk"/>
            <field name="groups" eval="[(4, ref('group_recruitment_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
