<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- List View -->
    <record id="view_job_position_list" model="ir.ui.view">
        <field name="name">recruitment.job.position.list</field>
        <field name="model">recruitment.job.position</field>
        <field name="arch" type="xml">
            <tree string="Vị trí tuyển dụng">
                <field name="name"/>
                <field name="department_id"/>
                <field name="job_level"/>
                <field name="employment_type"/>
                <field name="workplace_type"/>
                <field name="quantity"/>
                <field name="hired_quantity"/>
                <field name="hr_responsible_id" widget="many2one_avatar_user"/>
                <field name="deadline"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'recruiting'" decoration-danger="state == 'closed'"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_job_position_form" model="ir.ui.view">
        <field name="name">recruitment.job.position.form</field>
        <field name="model">recruitment.job.position</field>
        <field name="arch" type="xml">
            <form string="Vị trí tuyển dụng">
                <header>
                    <button name="action_recommend_top_candidates" string="🔍 Gợi ý Top 5 Ứng viên" type="object" class="btn-info fw-bold" groups="recruitment.group_recruitment_user,recruitment.group_recruitment_manager"/>
                    <button name="action_post_to_facebook" string="Đăng tin lên Facebook" type="object" class="btn-primary" icon="fa-facebook-square" invisible="facebook_post_id and not facebook_repost_allowed" groups="recruitment.group_recruitment_user,recruitment.group_recruitment_manager"/>
                    <button name="action_set_recruiting" string="Bắt đầu tuyển dụng" type="object" class="oe_highlight" invisible="state == 'recruiting'" groups="recruitment.group_recruitment_user,recruitment.group_recruitment_manager"/>
                    <button name="action_set_closed" string="Đóng tuyển dụng" type="object" class="btn-warning" invisible="state == 'closed'" groups="recruitment.group_recruitment_user,recruitment.group_recruitment_manager"/>
                    <button name="action_set_draft" string="Về bản nháp" type="object" class="btn-secondary" invisible="state == 'draft'" groups="recruitment.group_recruitment_user,recruitment.group_recruitment_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,recruiting,closed"/>
                    <field name="facebook_repost_allowed" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Tên Vị trí Tuyển dụng"/>
                        <h1>
                            <field name="name" placeholder="Ví dụ: Senior Python Developer"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Thông tin Tuyển dụng">
                            <field name="department_id" options="{'no_create_edit': True}"/>
                            <field name="job_level"/>
                            <field name="employment_type"/>
                            <field name="workplace_type"/>
                            <field name="hr_responsible_id" options="{'no_create': True}"/>
                        </group>

                        <group string="Chỉ tiêu &amp; Thời hạn">
                            <field name="quantity"/>
                            <field name="hired_quantity"/>
                            <field name="deadline"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string="Tích hợp Facebook Fanpage" invisible="not facebook_post_id" groups="recruitment.group_recruitment_user,recruitment.group_recruitment_manager">
                        <group>
                            <field name="facebook_post_id"/>
                            <field name="facebook_post_date"/>
                        </group>
                        <group>
                            <button name="action_open_facebook_post" string="Xem bài đăng trên Facebook" type="object" class="btn-link" icon="fa-external-link"/>
                        </group>
                    </group>

                    <group string="Yêu cầu Kỹ năng &amp; Lương ngân sách">
                        <group>
                            <field name="required_skills" placeholder="VD: Python, Odoo, HTML, CSS, SQL"/>
                            <field name="min_experience_years"/>
                            <field name="rag_index_status" widget="badge"/>
                            <field name="rag_indexed_at" invisible="rag_index_status != 'ready'"/>
                            <field name="rag_index_error" invisible="rag_index_status != 'failed'"/>
                        </group>
                        <group>
                            <field name="salary_min" groups="recruitment.group_recruitment_user,recruitment.group_recruitment_manager"/>
                            <field name="salary_max" groups="recruitment.group_recruitment_user,recruitment.group_recruitment_manager"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Mô tả công việc (JD)">
                            <field name="description" placeholder="Nhập mô tả chi tiết công việc, nhiệm vụ chính và quyền lợi..."/>
                        </page>

                        <page string="Danh sách Đơn ứng tuyển">
                            <field name="application_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="candidate_id"/>
                                    <field name="application_date"/>
                                    <field name="stage_id"/>
                                    <field name="interviewer_user_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_job_position_search" model="ir.ui.view">
        <field name="name">recruitment.job.position.search</field>
        <field name="model">recruitment.job.position</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="department_id"/>
                <field name="required_skills"/>
                <field name="hr_responsible_id"/>
                <filter string="Đang tuyển dụng" name="state_recruiting" domain="[('state', '=', 'recruiting')]"/>
                <filter string="Đã đóng" name="state_closed" domain="[('state', '=', 'closed')]"/>
                <filter string="Bản nháp" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter string="Đang hoạt động" name="active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Phòng ban" name="groupby_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Trạng thái" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Cấp bậc (Level)" name="groupby_level" context="{'group_by': 'job_level'}"/>
                    <filter string="Loại hình (Type)" name="groupby_type" context="{'group_by': 'employment_type'}"/>
                    <filter string="Mô hình (Workplace)" name="groupby_workplace" context="{'group_by': 'workplace_type'}"/>
                    <filter string="HR phụ trách" name="groupby_hr" context="{'group_by': 'hr_responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_job_position" model="ir.actions.act_window">
        <field name="name">Job Positions</field>
        <field name="res_model">recruitment.job.position</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_job_position_search"/>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_recruitment_root"
        name="Recruitment"
        sequence="10"
    />

    <menuitem
        id="menu_job_position"
        name="Job Positions"
        parent="menu_recruitment_root"
        action="action_job_position"
        sequence="10"
    />

</odoo>
