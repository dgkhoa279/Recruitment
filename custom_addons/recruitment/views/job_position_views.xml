<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- List View -->
    <record id="view_job_position_list" model="ir.ui.view">
        <field name="name">recruitment.job.position.list</field>
        <field name="model">recruitment.job.position</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="quantity"/>
                <field name="deadline"/>
                <field name="active"/>
            </tree>
        </field>
    </record>


    <!-- Form View -->
    <record id="view_job_position_form" model="ir.ui.view">
        <field name="name">recruitment.job.position.form</field>
        <field name="model">recruitment.job.position</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="quantity"/>
                        <field name="deadline"/>
                        <field name="active"/>
                    </group>

                    <group>
                        <field name="description"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- Action -->
    <record id="action_job_position" model="ir.actions.act_window">
        <field name="name">Job Positions</field>
        <field name="res_model">recruitment.job.position</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- Menu -->
    <menuitem
        id="menu_recruitment_root"
        name="Recruitment"
        sequence="10"
    />

    <menuitem
        id="menu_job_position"
        name="Job Positions"
        parent="menu_recruitment_root"
        action="action_job_position"
        sequence="10"
    />

</odoo>