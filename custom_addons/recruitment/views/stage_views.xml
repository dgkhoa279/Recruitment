<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Stage List -->
    <record id="view_stage_list" model="ir.ui.view">
        <field name="name">recruitment.stage.list</field>
        <field name="model">recruitment.stage</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence"/>
                <field name="name"/>
                <field name="fold"/>
                <field name="active"/>
            </tree>
        </field>
    </record>


    <!-- Stage Form -->
    <record id="view_stage_form" model="ir.ui.view">
        <field name="name">recruitment.stage.form</field>
        <field name="model">recruitment.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>

                        <group>
                            <field name="fold"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group>
                        <field name="description"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- Stage Action -->
    <record id="action_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">recruitment.stage</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- Configuration Menu -->
    <menuitem
        id="menu_recruitment_configuration"
        name="Configuration"
        parent="menu_recruitment_root"
        groups="recruitment.group_recruitment_manager"
        sequence="90"
    />

    <!-- Stage Menu -->
    <menuitem
        id="menu_stage"
        name="Stages"
        parent="menu_recruitment_configuration"
        action="action_stage"
        sequence="10"
    />

</odoo>