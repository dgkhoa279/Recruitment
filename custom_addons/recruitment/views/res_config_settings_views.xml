<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Res Config Settings View -->
    <record id="res_config_settings_view_form_recruitment" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.recruitment</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Tuyển dụng" string="Tuyển dụng" name="recruitment">
                    <block title="Tích hợp Facebook Fanpage Công ty">
                        <setting id="setting_facebook_integration" help="Cấu hình kết nối Facebook Graph API để tự động đăng tin tuyển dụng lên Facebook Fanpage">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="facebook_page_id" string="Facebook Page ID" class="col-lg-3 o_light_label"/>
                                    <field name="facebook_page_id" placeholder="Ví dụ: 102938475610293"/>
                                </div>
                                <div class="row mt16">
                                    <label for="facebook_page_access_token" string="Page Access Token" class="col-lg-3 o_light_label"/>
                                    <field name="facebook_page_access_token" password="True" placeholder="Dán Long-lived Page Access Token tại đây"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Cấu hình Cổng Thanh toán (VNPAY / MoMo / ZaloPay)">
                        <setting id="setting_vnpay_integration" help="Cấu hình thông số Merchant API VNPAY">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="vnpay_tmn_code" string="VNPAY TMN Code" class="col-lg-3 o_light_label"/>
                                    <field name="vnpay_tmn_code" placeholder="Mã TMN Code cấp bởi VNPAY"/>
                                </div>
                                <div class="row mt16">
                                    <label for="vnpay_hash_secret" string="VNPAY Hash Secret" class="col-lg-3 o_light_label"/>
                                    <field name="vnpay_hash_secret" password="True" placeholder="Chuỗi Hash Secret cấp bởi VNPAY"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="setting_momo_integration" help="Cấu hình thông số Partner API MoMo">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="momo_partner_code" string="MoMo Partner Code" class="col-lg-3 o_light_label"/>
                                    <field name="momo_partner_code" placeholder="Mã Partner Code cấp bởi MoMo"/>
                                </div>
                                <div class="row mt16">
                                    <label for="momo_secret_key" string="MoMo Secret Key" class="col-lg-3 o_light_label"/>
                                    <field name="momo_secret_key" password="True" placeholder="Chuỗi Secret Key cấp bởi MoMo"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="setting_zalopay_integration" help="Cấu hình thông số App API ZaloPay">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="zalopay_app_id" string="ZaloPay App ID" class="col-lg-3 o_light_label"/>
                                    <field name="zalopay_app_id" placeholder="Mã App ID cấp bởi ZaloPay"/>
                                </div>
                                <div class="row mt16">
                                    <label for="zalopay_key1" string="ZaloPay Key 1" class="col-lg-3 o_light_label"/>
                                    <field name="zalopay_key1" password="True" placeholder="Khóa Key1 cấp bởi ZaloPay"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Settings Action -->
    <record id="action_recruitment_config_settings" model="ir.actions.act_window">
        <field name="name">Cài đặt Tuyển dụng</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'recruitment'}</field>
    </record>

    <!-- Menuitem Payment Providers -->
    <menuitem id="menu_recruitment_payment_providers"
              name="Phương thức thanh toán"
              parent="menu_recruitment_configuration"
              action="payment.action_payment_provider"
              sequence="30"/>

    <!-- Menuitem -->
    <menuitem id="menu_recruitment_settings"
              name="Cài đặt (Settings)"
              parent="menu_recruitment_configuration"
              action="action_recruitment_config_settings"
              sequence="100"/>

</odoo>
