<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_tool_tree" model="ir.ui.view">
        <field name="name">recruitment.ai.tool.tree</field>
        <field name="model">recruitment.ai.tool</field>
        <field name="arch" type="xml">
            <tree string="Công cụ AI đã tạo">
                <field name="name"/>
                <field name="execution_count"/>
                <field name="last_execution_date"/>
                <field name="is_valid" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_ai_tool_form" model="ir.ui.view">
        <field name="name">recruitment.ai.tool.form</field>
        <field name="model">recruitment.ai.tool</field>
        <field name="arch" type="xml">
            <form string="Công cụ AI">
                <header>
                    <button name="action_execute_tool" string="▶️ Chạy Tool" type="object" class="btn-success fw-bold"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="is_valid" readonly="1"/>
                        </group>
                        <group>
                            <field name="execution_count" readonly="1"/>
                            <field name="last_execution_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Yêu cầu Prompt Ban Đầu">
                            <field name="prompt" placeholder="Nội dung prompt..."/>
                        </page>
                        <page string="Mã Nguồn Python (Đã Duyệt AST)">
                            <field name="python_code" widget="ace" options="{'mode': 'python'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_tool" model="ir.actions.act_window">
        <field name="name">Công cụ AI đã sinh</field>
        <field name="res_model">recruitment.ai.tool</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_recruitment_ai_tools"
              name="🤖 Công cụ AI đã tạo"
              parent="menu_recruitment_configuration"
              action="action_ai_tool"
              sequence="30"/>
</odoo>
