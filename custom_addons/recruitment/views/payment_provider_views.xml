<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit payment.provider form view if extra recruitment fields are needed -->
    <record id="payment_provider_form_inherit_recruitment" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit.recruitment</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <!-- Reserved for recruitment payment providers -->
            </xpath>
        </field>
    </record>

</odoo>
