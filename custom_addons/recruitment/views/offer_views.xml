<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Offer List -->
    <record id="view_offer_list" model="ir.ui.view">
        <field name="name">recruitment.offer.list</field>
        <field name="model">recruitment.offer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="candidate_id"/>
                <field name="job_position_id"/>
                <field name="offer_date"/>
                <field name="expiration_date"/>
                <field name="proposed_salary"/>
                <field name="salary_period"/>
                <field name="status"/>
            </tree>
        </field>
    </record>


    <!-- Offer Form -->
    <record id="view_offer_form" model="ir.ui.view">
        <field name="name">recruitment.offer.form</field>
        <field name="model">recruitment.offer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="application_id"/>
                            <field name="candidate_id"/>
                            <field name="job_position_id"/>
                        </group>

                        <group>
                            <field name="offer_date"/>
                            <field name="expiration_date"/>
                            <field name="start_date"/>
                        </group>
                    </group>

                    <group string="Salary">
                        <field name="proposed_salary"/>
                        <field name="salary_period"/>
                    </group>

                    <group string="Status">
                        <field name="status"/>
                    </group>

                    <notebook>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <!-- Offer Action -->
    <record id="action_offer" model="ir.actions.act_window">
        <field name="name">Job Offers</field>
        <field name="res_model">recruitment.offer</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- Offer Menu -->
    <menuitem
        id="menu_offer"
        name="Job Offers"
        parent="menu_recruitment_root"
        action="action_offer"
        groups="recruitment.group_recruitment_user,recruitment.group_recruitment_manager"
        sequence="60"
    />

</odoo>