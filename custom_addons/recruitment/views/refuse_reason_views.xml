<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Refuse Reason List View -->
    <record id="view_recruitment_refuse_reason_tree" model="ir.ui.view">
        <field name="name">recruitment.refuse.reason.tree</field>
        <field name="model">recruitment.refuse.reason</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="template_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Refuse Reason Form View -->
    <record id="view_recruitment_refuse_reason_form" model="ir.ui.view">
        <field name="name">recruitment.refuse.reason.form</field>
        <field name="model">recruitment.refuse.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="template_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Refuse Reason Action -->
    <record id="action_recruitment_refuse_reason" model="ir.actions.act_window">
        <field name="name">Refuse Reasons</field>
        <field name="res_model">recruitment.refuse.reason</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Configuration Menu -->
    <menuitem
        id="menu_recruitment_configuration"
        name="Configuration"
        parent="menu_recruitment_root"
        sequence="90"
    />

    <!-- Refuse Reason Menu -->
    <menuitem
        id="menu_recruitment_refuse_reason"
        name="Refuse Reasons"
        parent="menu_recruitment_configuration"
        action="action_recruitment_refuse_reason"
        sequence="10"
    />

</odoo>
