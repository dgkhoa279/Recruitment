<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Application List -->
    <record id="view_application_list" model="ir.ui.view">
        <field name="name">recruitment.application.list</field>
        <field name="model">recruitment.application</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="candidate_id"/>
                <field name="job_position_id"/>
                <field name="application_date"/>
                <field name="stage_id"/>
                <field name="source"/>
                <field name="interview_date"/>
            </tree>
        </field>
    </record>


    <!-- Application Form -->
<record id="view_application_form" model="ir.ui.view">
    <field name="name">recruitment.application.form</field>
    <field name="model">recruitment.application</field>
    <field name="arch" type="xml">
        <form>
            <sheet>

                <!-- Basic Information -->
                <group>
                    <group>
                        <field name="name"
                               readonly="1"
                               force_save="1"/>
                        <field name="candidate_id"/>
                        <field name="job_position_id"/>
                        <field name="application_date"/>
                    </group>

                    <group>
                        <field name="stage_id"/>
                        <field name="source"/>
                        <field name="interview_date"/>
                        <field name="active"/>
                    </group>
                </group>

                    <notebook>
                        <!-- CV -->
                        <page string="CV">
                            <group>
                                <field name="cv_file" filename="cv_filename"/>
                                <field name="cv_filename" invisible="1"/>
                            </group>
                        </page>

                        <!-- Notes -->
                        <page string="Notes">
                            <field name="note"/>
                        </page>

                        <!-- Interviews -->
                        <page string="Interviews">
                            <field name="interview_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="interviewer"/>
                                    <field name="scheduled_date"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>

                        <!-- Offers -->
                        <page string="Offers">
                            <field name="offer_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="offer_date"/>
                                    <field name="expiration_date"/>
                                    <field name="proposed_salary"/>
                                    <field name="salary_period"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

            </sheet>
        </form>
    </field>
</record>


    <!-- Application Action -->
    <record id="action_application" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">recruitment.application</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- Application Menu -->
    <menuitem
        id="menu_application"
        name="Applications"
        parent="menu_recruitment_root"
        action="action_application"
        sequence="30"
    />

</odoo>