<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Application List (Tree View) -->
    <record id="view_application_list" model="ir.ui.view">
        <field name="name">recruitment.application.list</field>
        <field name="model">recruitment.application</field>
        <field name="arch" type="xml">
            <tree string="Applications">
                <field name="name"/>
                <field name="candidate_id"/>
                <field name="job_position_id"/>
                <field name="department_id" optional="show"/>
                <field name="matching_score" widget="progressbar" string="Độ phù hợp (%)" optional="show"/>
                <field name="application_date"/>
                <field name="stage_id"/>
                <field name="source"/>
                <field name="interviewer_user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="interview_date"/>
                <field name="refuse_reason_id" optional="hide"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Application Kanban View -->
    <record id="view_application_kanban" model="ir.ui.view">
        <field name="name">recruitment.application.kanban</field>
        <field name="model">recruitment.application</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column o_kanban_applicant" sample="1">
                <field name="stage_id"/>
                <field name="name"/>
                <field name="candidate_id"/>
                <field name="job_position_id"/>
                <field name="department_id"/>
                <field name="interviewer_user_id"/>
                <field name="interview_date"/>
                <field name="matching_score"/>
                <field name="is_vip_paid"/>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title mb-1">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_subtitle text-muted mb-1">
                                    <field name="candidate_id"/>
                                </div>
                                <div class="d-flex align-items-center flex-wrap gap-1">
                                    <span class="badge rounded-pill text-bg-info me-1"><field name="job_position_id"/></span>
                                    <t t-if="record.is_vip_paid.raw_value">
                                        <span class="badge rounded-pill text-bg-warning me-1"><i class="fa fa-bolt me-1"/>VIP Hired</span>
                                    </t>
                                    <t t-if="record.department_id.raw_value">
                                        <span class="badge rounded-pill text-bg-secondary me-1"><field name="department_id"/></span>
                                    </t>
                                    <t t-if="record.matching_score.raw_value &gt; 0">
                                        <span t-attf-class="badge rounded-pill #{record.matching_score.raw_value &gt;= 70 ? 'text-bg-success' : (record.matching_score.raw_value &gt;= 40 ? 'text-bg-warning' : 'text-bg-danger')}">
                                            <i class="fa fa-check-circle me-1"/><t t-esc="record.matching_score.raw_value"/>% Matched
                                        </span>
                                    </t>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left text-muted">
                                        <i class="fa fa-calendar me-1" title="Interview Date"/> <field name="interview_date"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                        <field name="interviewer_user_id" widget="many2one_avatar_user" class="ms-1"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Application Search View -->
    <record id="view_application_search" model="ir.ui.view">
        <field name="name">recruitment.application.search</field>
        <field name="model">recruitment.application</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="candidate_id"/>
                <field name="job_position_id"/>
                <field name="department_id"/>
                <field name="interviewer_user_id"/>
                <field name="stage_id"/>
                <field name="matched_skills"/>
                <filter string="Phù hợp cao (>= 70%)" name="high_match" domain="[('matching_score', '>=', 70)]"/>
                <filter string="Phù hợp trung bình (40-69%)" name="mid_match" domain="[('matching_score', '>=', 40), ('matching_score', '&lt;', 70)]"/>
                <filter string="Phù hợp thấp (&lt; 40%)" name="low_match" domain="[('matching_score', '&lt;', 40)]"/>
                <separator/>
                <filter string="Đang hoạt động" name="active" domain="[('active', '=', True)]"/>
                <filter string="Đã từ chối (Archived)" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Phòng ban" name="groupby_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Trạng thái (Stage)" name="groupby_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Người phỏng vấn (Interviewer)" name="groupby_interviewer" context="{'group_by': 'interviewer_user_id'}"/>
                    <filter string="Vị trí tuyển dụng" name="groupby_job" context="{'group_by': 'job_position_id'}"/>
                    <filter string="Lý do từ chối" name="groupby_refuse_reason" context="{'group_by': 'refuse_reason_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Application Form View -->
    <record id="view_application_form" model="ir.ui.view">
        <field name="name">recruitment.application.form</field>
        <field name="model">recruitment.application</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_scan_cv" string="Quét CV" type="object" class="btn-info fw-bold" invisible="not cv_file" groups="recruitment.group_recruitment_user,recruitment.group_recruitment_manager"/>
                    <button name="action_send_interview_email" string="Mời phỏng vấn" type="object" class="oe_highlight" invisible="not active" groups="recruitment.group_recruitment_user,recruitment.group_recruitment_manager"/>
                    <button name="action_send_offer_email" string="Mời nhận việc" type="object" class="btn-success" invisible="not active" groups="recruitment.group_recruitment_user,recruitment.group_recruitment_manager"/>
                    <button name="action_open_payment_wizard" string="Thanh toán" type="object" class="btn-warning" icon="fa-credit-card" invisible="not active or is_vip_paid" groups="recruitment.group_recruitment_manager"/>
                    <button name="action_open_refuse_wizard" string="Từ chối" type="object" class="btn-danger" invisible="not active"/>
                    <button name="action_restore_application" string="Khôi phục" type="object" class="btn-primary" invisible="active" icon="fa-undo" groups="recruitment.group_recruitment_user,recruitment.group_recruitment_manager"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="is_vip_paid" invisible="1"/>
                    <widget name="web_ribbon" title="Refused" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="VIP Hired" bg_color="text-bg-warning" invisible="not is_vip_paid"/>

                    <!-- Basic Information -->
                    <group>
                        <group>
                            <field name="name"
                                   readonly="1"
                                   force_save="1"/>
                            <field name="candidate_id"/>
                            <field name="job_position_id"/>
                            <field name="department_id"/>
                            <field name="application_date"/>
                        </group>

                        <group>
                            <field name="source"/>
                            <field name="expected_salary" groups="recruitment.group_recruitment_user,recruitment.group_recruitment_manager"/>
                            <field name="interviewer_user_id" options="{'no_create': True}"/>
                            <field name="interview_date"/>
                            <field name="refuse_reason_id" invisible="active"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <!-- CV Skill Matching Result Box -->
                    <group string="Kết quả Quét CV" invisible="not cv_file">
                        <group>
                            <field name="matching_score" widget="progressbar"/>
                        </group>
                        <group>
                            <field name="matched_skills" class="text-success fw-bold"/>
                            <field name="missing_skills" class="text-danger fw-bold"/>
                        </group>
                        <group class="w-100" invisible="not ai_summary">
                            <field name="ai_summary" style="font-style: italic; background-color: #f8f9fa; border-left: 4px solid #0d6efd; padding: 10px;"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- CV -->
                        <page string="CV File">
                            <group>
                                <field name="cv_file" filename="cv_filename"/>
                                <field name="cv_filename" invisible="1"/>
                            </group>
                        </page>

                        <!-- Notes -->
                        <page string="Notes">
                            <field name="note"/>
                        </page>

                        <!-- Interviews -->
                        <page string="Interviews">
                            <field name="interview_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="interviewer"/>
                                    <field name="scheduled_date"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>

                        <!-- Offers -->
                        <page string="Offers" groups="recruitment.group_recruitment_user,recruitment.group_recruitment_manager">
                            <field name="offer_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="offer_date"/>
                                    <field name="expiration_date"/>
                                    <field name="proposed_salary"/>
                                    <field name="salary_period"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
                <div class="o_attachment_preview"/>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Application Graph View -->
    <record id="view_application_graph" model="ir.ui.view">
        <field name="name">recruitment.application.graph</field>
        <field name="model">recruitment.application</field>
        <field name="arch" type="xml">
            <graph string="Phân tích Đơn ứng tuyển" type="bar" sample="1">
                <field name="stage_id"/>
                <field name="job_position_id"/>
            </graph>
        </field>
    </record>

    <!-- Application Pivot View -->
    <record id="view_application_pivot" model="ir.ui.view">
        <field name="name">recruitment.application.pivot</field>
        <field name="model">recruitment.application</field>
        <field name="arch" type="xml">
            <pivot string="Bảng phân tích Tuyển dụng" sample="1">
                <field name="job_position_id" type="row"/>
                <field name="stage_id" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Application Action -->
    <record id="action_application" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">recruitment.application</field>
        <field name="view_mode">kanban,tree,form,graph,pivot</field>
        <field name="search_view_id" ref="view_application_search"/>
        <field name="context">{'search_default_groupby_stage': 1}</field>
    </record>

    <!-- Application Menu -->
    <menuitem
        id="menu_application"
        name="Applications"
        parent="menu_recruitment_root"
        action="action_application"
        sequence="30"
    />

</odoo>