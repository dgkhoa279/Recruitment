<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_generated_tool_execution_form" model="ir.ui.view">
        <field name="name">muk_ai.generated.tool.execution.form</field>
        <field name="model">muk_ai.generated.tool.execution</field>
        <field name="arch" type="xml">
            <form string="Run Tool" create="0" delete="0">
                <sheet>
                    <field name="state" invisible="1"/>
                    <group><field name="tool_id"/><field name="session_id" invisible="not session_id"/></group>
                    <group invisible="state == 'done'">
                        <field name="original_request"/>
                        <field name="task_text"/>
                    </group>
                    <field name="line_ids" invisible="state == 'done'">
                        <tree editable="bottom" create="0" delete="0">
                            <field name="name" column_invisible="True"/>
                            <field name="label"/>
                            <field name="kind"/>
                            <field name="required_input"/>
                            <field name="include_value"/>
                            <field name="text_value" invisible="kind == 'boolean'"/>
                            <field name="boolean_value" invisible="kind != 'boolean'"/>
                            <field name="help_text" optional="hide"/>
                        </tree>
                    </field>
                    <group invisible="state == 'done'">
                        <field name="task_reviewed"/>
                        <field name="allow_ai"/>
                    </group>
                    <group invisible="state != 'preview'">
                        <field name="preview_text" nolabel="1"/>
                        <field name="changes_reviewed"/>
                    </group>
                    <group invisible="state != 'done'">
                        <field name="result_text" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_preview" type="object" string="Preview" class="btn-primary" invisible="state not in ['draft', 'failed']"/>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'preview'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_generated_tool_run_form" model="ir.ui.view">
        <field name="name">muk_ai.generated.tool.run.form</field>
        <field name="model">muk_ai.generated.tool.run</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0"><sheet>
                <group><field name="tool_id"/><field name="user_id"/><field name="revision"/><field name="status"/><field name="duration_ms"/></group>
                <group><field name="input_data" widget="json"/><field name="result" widget="json"/><field name="error_message"/><field name="user_feedback"/></group>
            </sheet></form>
        </field>
    </record>
</odoo>
