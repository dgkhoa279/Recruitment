<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit payment.provider form view to display VNPAY credential settings -->
    <record id="payment_provider_form_inherit_vnpay" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit.vnpay</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Cấu hình Cổng Thanh Toán VNPAY" invisible="code != 'vnpay'">
                    <group>
                        <field name="vnpay_tmn_code"/>
                        <field name="vnpay_hash_secret" password="True"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
